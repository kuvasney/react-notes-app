# Exemplo de configuração das variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores conforme necessário

# URL base da API (sem barra no final)
VITE_API_BASE_URL=http://localhost:3001

# Timeout das requisições em milissegundos
VITE_API_TIMEOUT=10000

# Ambiente de execução
# Valores possíveis:
# - "development" = desenvolvimento com API real
# - "nodata" = desenvolvimento com dados mockados (MSW)
# - "production" = produção
VITE_NODE_ENV=development

# Ativar modo debug (true/false)
VITE_DEBUG_MODE=true
